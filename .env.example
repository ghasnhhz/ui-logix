# Neon Postgres — pooled connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/ulogix?sslmode=require"

# Direct connection, used by prisma migrate
DIRECT_URL="postgresql://user:password@host.neon.tech/ulogix?sslmode=require"

# At least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo account for `npm run db:seed`. DEMO_PASSWORD has no default — the seed
# refuses to run without it, so no credential ever lands in a tracked file.
DEMO_EMAIL="demo@ulogix.uz"
DEMO_PASSWORD=""
DEMO_COMPANY="Silk Road Textiles"
